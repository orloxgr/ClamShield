{
  "name": "clamshield",
  "description": "ClamShield - Windows GUI for ClamAV",
  "author": "Byron Iniotakis",
  "private": true,
  "version": "1.2.3",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "desktop": "electron .",
    "build": "vite build && esbuild server.ts --platform=node --packages=external --bundle --outfile=dist/server.cjs",
    "prebuild:exe": "node scripts/prepare-release.cjs",
    "build:exe": "npm run build && electron-builder",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "release:checksums": "node scripts/generate-checksums.cjs"
  },
  "build": {
    "appId": "com.clamshield.app",
    "productName": "ClamShield",
    "directories": {
      "output": "release/${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "runAfterFinish": true,
      "license": "build/eula.txt",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "ClamShield",
      "artifactName": "ClamShield-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "engine/**/*",
      "data/**/*",
      "public/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
