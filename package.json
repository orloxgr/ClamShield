{
  "name": "clamshield",
  "description": "ClamShield - Windows GUI for ClamAV",
  "author": "Byron Iniotakis",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "desktop": "electron .",
    "build": "npm run build:localization && vite build && esbuild server.ts --platform=node --packages=external --bundle --outfile=dist/server.cjs",
    "build:shell": "node scripts/build-shell-extension.cjs",
    "prebuild:exe": "npm run audit:security && node scripts/prepare-release.cjs",
    "build:exe": "npm run build:shell && npm run build && electron-builder",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:virustotal-scan": "node --import tsx --test server/virusTotalScanQueue.test.ts server/virusTotalUsage.test.ts server/virusTotalFileAnalysis.test.ts server/virusTotalLimitWarning.test.ts server/virusTotalQueueView.test.ts server/virusTotalResultWorkflow.test.ts server/resultEvidence.test.ts",
    "test:updates": "node --import tsx --test server/freshclamTimeout.test.ts",
    "test:startup": "node --import tsx --test server/startup.test.ts server/desktopDiagnostics.test.ts",
    "test:desktop-navigation": "node scripts/test-desktop-navigation.cjs",
    "test:alerts": "node --import tsx --test server/pendingThreats.test.ts && node scripts/test-desktop-alerts.cjs",
    "test:release-security": "node --import tsx --test server/releaseSecurity.test.ts",
    "test:virustotal-ui": "node scripts/test-virustotal-queue-ui.cjs",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "audit:security": "node scripts/verify-release-security.cjs",
    "release:checksums": "node scripts/generate-checksums.cjs",
    "test:exceptions": "node --import tsx --test server/exceptionReporting.test.ts server/exceptionRoutes.test.ts",
    "build:localization": "node scripts/build-localization.cjs",
    "predev": "npm run build:localization",
    "predesktop": "npm run build:localization",
    "test": "npm run build:localization && node --import tsx --test server/*.test.ts",
    "test:localization-ui": "node scripts/test-localization-ui.cjs",
    "languages:check": "tsx scripts/check-languages.ts",
    "languages:template": "tsx scripts/language-template.ts"
  },
  "build": {
    "appId": "com.clamshield.app",
    "productName": "ClamShield",
    "beforePack": "scripts/verify-release-security.cjs",
    "afterSign": "scripts/sign-windows-artifacts.cjs",
    "afterAllArtifactBuild": "scripts/sign-windows-artifacts.cjs",
    "directories": {
      "output": "release/${version}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "runAfterFinish": true,
      "license": "build/eula.txt",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "multiLanguageInstaller": false,
      "uninstallDisplayName": "ClamShield",
      "artifactName": "ClamShield-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "engine/**/*",
      "data/**/*",
      "public/**/*"
    ],
    "extraFiles": [
      {
        "from": "shell",
        "to": "shell",
        "filter": [
          "ClamShieldShellExt.dll",
          "ClamShieldContextMenu.ps1",
          "ClamShieldContextMenu.vbs"
        ]
      },
      {
        "from": "sparse-package",
        "to": "sparse-package",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "languages",
        "to": "languages",
        "filter": [
          "*.json",
          "README.md"
        ]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  }
}
